[plugins]
disabled-actions=@as []
disabled-extensions=@as []

[preferences]
show-hidden-files=true
size-prefixes='base-2'

[search]
search-reverse-sort=false
search-sort-column='name'

[window-state]
geometry='800x550+1069+144'
maximized=false
side-pane-view='places'
sidebar-bookmark-breakpoint=6
start-with-sidebar=true
